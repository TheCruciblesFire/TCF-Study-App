# Demo works without credentials. Set live only after supplying all three values.
APP_MODE=demo
PORT=3000
HOST=0.0.0.0
# Local default. On Render omit this field to use RENDER_EXTERNAL_URL automatically.
PUBLIC_ORIGIN=http://localhost:3000
# HTTPS origins permitted to frame the app (space-separated, no wildcard).
EMBED_ORIGINS=https://thecruciblesfire.org https://www.thecruciblesfire.org
TCF_OPENAI_API_KEY=
TCF_BIBLE_API_KEY=
BIBLE_ID=9879dbb7cfe39e4d-01
# API.Bible's public-domain World English Bible (WEB); confirm this ID is available to your API key.
OPENAI_MODEL=gpt-4.1-mini
# USD per million tokens; update when changing models or provider pricing.
INPUT_USD_PER_MILLION=0.40
OUTPUT_USD_PER_MILLION=1.60
DAILY_BUDGET_USD=2
MONTHLY_BUDGET_USD=20
MAX_TURN_USD=0.03
REQUESTS_PER_MINUTE=8
REQUESTS_PER_DAY=40
# Keep 0 unless your host supplies exactly this many trusted reverse proxies.
TRUST_PROXY_HOPS=0
DATA_DIR=.data
