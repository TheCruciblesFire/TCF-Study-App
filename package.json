{
  "name": "tcf-study-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.5.0 <25" },
  "scripts": {
    "start": "node --use-env-proxy --env-file-if-exists=.env server/index.js",
    "dev": "node --use-env-proxy --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.js",
    "test:browser": "node scripts/browser-smoke.js",
    "test:reporting": "node scripts/reporting-smoke.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "preview:build": "node scripts/build-preview.js",
    "preview:test": "npm run preview:build && node scripts/preview-smoke.js",
    "usage": "node --env-file-if-exists=.env scripts/usage.js"
  },
  "dependencies": { "express": "5.1.0", "zod": "4.1.12" },
  "devDependencies": { "@playwright/test": "1.56.1" }
}
